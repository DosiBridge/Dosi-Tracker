# Dosi-Tracker self-hosted stack (docker-compose.yml): every variable it reads.
#
#   cp .env.example .env     then fill in the REQUIRED values. .env is git-ignored: never commit it.
#
# This file is a template and holds no secret. Generate each secret yourself, for example:
#   openssl rand -hex 32
# (hex keeps them free of characters that need quoting; a database password must not contain ';'.)
# docker compose stops with "required variable ... is missing a value" while a REQUIRED value is empty.

# --- Public URLs (REQUIRED) -----------------------------------------------------------------------------------------
# Where browsers and desktop agents reach the API and the dashboard. https:// in production: the API issues tokens
# over HTTPS only, and the agents refuse plain http:// except for loopback. Both host names must resolve to the
# reverse proxy (the bundled one: `docker compose --profile proxy up -d`).
TRACKER_API_URL=https://tracker-api.example.com
TRACKER_WEB_URL=https://tracker.example.com

# --- Database (REQUIRED: password) ----------------------------------------------------------------------------------
# Applied when the volume is first initialised; changing it later does not change the existing database's password.
TRACKER_DB_NAME=Tracker
TRACKER_DB_USER=tracker
TRACKER_DB_PASSWORD=

# --- First platform administrator (REQUIRED) ------------------------------------------------------------------------
# Created by the migrator on an empty database only (user name "admin"); later runs never change it. The migrator
# refuses the template password 1q2w3E*. ASP.NET Identity rules: 6+ characters with upper and lower case, a digit and
# a symbol. Change it after the first sign-in.
TRACKER_ADMIN_EMAIL=admin@example.com
TRACKER_ADMIN_PASSWORD=

# --- Token signing certificate and encryption (REQUIRED) ------------------------------------------------------------
# Passphrase of ./certs/openiddict.pfx. Create the file once with: docker compose --profile init run --rm certgen
TRACKER_CERT_PASSPHRASE=
# Validity of a certificate created by certgen, in days.
TRACKER_CERT_DAYS=730
# Another path to the certificate on this machine (default ./certs/openiddict.pfx).
# TRACKER_OPENIDDICT_PFX=./certs/openiddict.pfx
# Key for values the API stores encrypted (e.g. settings). Keep it stable: changing it makes them unreadable.
TRACKER_ENCRYPTION_PASSPHRASE=

# --- Network ---------------------------------------------------------------------------------------------------------
# Host interface the API (TRACKER_API_PORT) and dashboard (TRACKER_WEB_PORT) ports are published on. Keep loopback
# unless your own reverse proxy runs on another machine.
TRACKER_BIND_ADDRESS=127.0.0.1
TRACKER_API_PORT=6006
TRACKER_WEB_PORT=6005
# Subnet of the "edge" Docker network. The API trusts X-Forwarded-For/-Proto only from it (and loopback), so only
# the proxy and Docker's port publishing sit on it. Change it if it collides with a network on this host.
TRACKER_EDGE_SUBNET=172.30.250.0/24

# --- Bundled reverse proxy (profile "proxy") ---------------------------------------------------------------------------
# "internal" = certificates from Caddy's local CA (testing; clients must trust it). For publicly trusted certificates
# (Let's Encrypt / ZeroSSL) set your e-mail address instead; ports 80 and 443 must then be reachable from the internet.
TRACKER_PROXY_TLS=internal
TRACKER_PROXY_BIND_ADDRESS=0.0.0.0
TRACKER_PROXY_HTTP_PORT=80
TRACKER_PROXY_HTTPS_PORT=443

# --- Web dashboard ----------------------------------------------------------------------------------------------------
# Where the dashboard's download page sends people for the desktop agents.
TRACKER_DOWNLOAD_BASE_URL=https://github.com/DosiBridge/Dosi-Tracker/releases/latest/download
# "true" lets the dashboard use a plain-http, non-loopback TRACKER_API_URL (an explicit, insecure opt-in).
TRACKER_ALLOW_INSECURE_HTTP=false

# --- Images (optional) --------------------------------------------------------------------------------------------------
# Tags given to the locally built images, or published images to run instead of building.
# TRACKER_API_IMAGE=dosi-tracker-api:local
# TRACKER_MIGRATOR_IMAGE=dosi-tracker-migrator:local
# TRACKER_WEB_IMAGE=dosi-tracker-web:local

# =====================================================================================================================
# Optional API settings. These use the API's own configuration names and are passed to it only when set here
# (a commented-out line means "not set": the built-in default applies).
# =====================================================================================================================

# --- AI assistant (off by default) --------------------------------------------------------------------------------------
# Leave the key empty unless you enable the feature; it is a secret like the ones above.
AI__Enabled=false
AI__Provider=OpenAI
AI__OpenAI__ApiKey=
# AI__OpenAI__Model=
# AI__OpenAI__BaseUrl=

# --- Billing ------------------------------------------------------------------------------------------------------------
# false = no trials or invoices: every workspace stays active (the self-hosting default).
Billing__Enabled=false

# --- Outgoing e-mail (SMTP) ---------------------------------------------------------------------------------------------
# For the e-mail the API sends (for example account password-reset messages). Uncomment and fill in to enable.
# The password is accepted in plain text here (the API then logs a "failed to decrypt the setting" warning that does
# not contain the value); alternatively the host administrator sets it with PUT /api/setting-management/emailing,
# which stores it encrypted.
# Settings__Abp.Mailing.Smtp.Host=smtp.example.com
# Settings__Abp.Mailing.Smtp.Port=587
# Settings__Abp.Mailing.Smtp.UserName=
# Settings__Abp.Mailing.Smtp.Password=
# Settings__Abp.Mailing.Smtp.EnableSsl=true
# Settings__Abp.Mailing.Smtp.UseDefaultCredentials=false
# Settings__Abp.Mailing.DefaultFromAddress=no-reply@example.com
# Settings__Abp.Mailing.DefaultFromDisplayName=Dosi Tracker

# --- Screenshot / webcam storage ------------------------------------------------------------------------------------------
# Captures are stored in PostgreSQL unless an S3 or S3-compatible store (Cloudflare R2, MinIO, ...) is configured.
# An incomplete S3 configuration stops the API at start-up.
# S3__AccessKeyId=
# S3__SecretAccessKey=
# S3__ContainerName=
# S3__Region=
# S3__ServiceUrl=
