{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dosi-tracker/cli-envelope.v1.json",
  "title": "dosi-tracker --json envelope (dosi-tracker.cli/1)",
  "description": "Exactly one document per command: a success with its result, or a failure with the error and the exit code.",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "command", "ok", "result"],
      "properties": {
        "schema": { "const": "dosi-tracker.cli/1" },
        "command": { "type": "string" },
        "ok": { "const": true },
        "changed": { "type": "boolean" },
        "result": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "command", "ok", "error"],
      "properties": {
        "schema": { "const": "dosi-tracker.cli/1" },
        "command": { "type": "string" },
        "ok": { "const": false },
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "hint", "exit_code"],
          "properties": {
            "code": {
              "enum": ["bad_request", "unknown_method", "unsupported_version", "not_signed_in", "sign_in_failed",
                       "sign_in_expired", "keyring_locked", "consent_required", "capability_unavailable",
                       "choice_required", "not_found", "precondition", "no_session", "device_revoked", "offline",
                       "timeout", "busy", "permission_denied", "internal", "daemon_not_running"]
            },
            "message": { "type": "string" },
            "hint": { "type": ["string", "null"] },
            "exit_code": { "enum": [1, 2, 3, 4, 5, 6, 7, 8, 9] },
            "data": {}
          }
        }
      }
    }
  ]
}
