# Dosi-Tracker web dashboard: runtime configuration.
#
# These are read by the server on every request (src/lib/runtime-config.ts),
# so one build or container image works in every environment: set them where
# the server runs (`next start`, `node .next/standalone/server.js`, the
# container), not at build time. For `npm run dev`, copy this file to
# `.env.local`.

# The Dosi-Tracker API this web app and every desktop agent sign in to.
# Required in production (without it sign-in is impossible and /healthz answers
# 503). https only, except loopback hosts. Outside production it defaults to
# the backend's dev address, https://localhost:6006.
DOSI_API_URL=https://localhost:6006

# Where the desktop agent release assets are downloaded from. The page links
# <this>/dosi-tracker-setup.exe, /DosiTracker-macos.zip,
# /dosi-tracker-linux-x86_64.tar.gz, /dosi-tracker_amd64.deb,
# /dosi-tracker.x86_64.rpm and /SHA256SUMS.
# DOSI_DOWNLOAD_BASE_URL=https://github.com/DosiBridge/Dosi-Tracker/releases/latest/download

# Serve the built-in demo dataset to visitors without a session (demos, the
# E2E suite). Off by default; never turn it on for a real deployment.
# DOSI_DEMO_MODE=1

# Accept a plain http:// API or download address that is not loopback.
# An explicit opt-in for closed networks only.
# DOSI_ALLOW_INSECURE_HTTP=true
