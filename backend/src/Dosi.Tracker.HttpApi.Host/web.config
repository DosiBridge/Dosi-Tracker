<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Dosi.Tracker.HttpApi.Host.dll" stdoutLogEnabled="false" stdoutLogFile=".\Logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- The app limits request bodies itself (32 MB, TrackerHttpApiHostModule.MaxRequestBodyBytes) and answers a
               larger one with 413, which tells the desktop agents to resend a block without its images. IIS's own
               filter (28.6 MB by default) would refuse such uploads earlier, with a 404.13 the agents only retry, so
               it is lifted to its maximum. -->
          <requestLimits maxAllowedContentLength="4294967295" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="x-powered-by" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
