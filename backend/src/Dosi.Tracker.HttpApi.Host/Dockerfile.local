FROM mcr.microsoft.com/dotnet/sdk:10.0  AS base
USER $APP_UID
EXPOSE 8080
EXPOSE 8081

COPY bin/Release/net10.0/publish/ app/
WORKDIR /app

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
# Must match AuthServer__CertificatePassPhrase at runtime (docker-compose passes the same
# TRACKER_CERT_PASSPHRASE to both). The default is the ABP template value — local use only.
ARG TRACKER_CERT_PASSPHRASE=3f027835-7c52-4bf7-bc1f-77582ca37aef
WORKDIR /src
RUN dotnet dev-certs https -v -ep openiddict.pfx -p "$TRACKER_CERT_PASSPHRASE"
RUN chmod 644 openiddict.pfx

FROM base AS final
WORKDIR /app
COPY --from=build /src .

ENTRYPOINT ["dotnet", "Dosi.Tracker.HttpApi.Host.dll"]