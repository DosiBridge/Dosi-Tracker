<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dosi.Tracker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host's OpenIddict handlers binding agent tokens to their device run against the real (SQLite-backed)
         OpenIddict stores here. Compiled in rather than referencing the host, like the host files linked into the other
         test projects. -->
    <Compile Include="..\..\src\Dosi.Tracker.HttpApi.Host\Devices\DeviceTokenHandlers.cs" Link="Devices\Host\DeviceTokenHandlers.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dosi.Tracker.EntityFrameworkCore\Dosi.Tracker.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Dosi.Tracker.HttpApi\Dosi.Tracker.HttpApi.csproj" />
    <ProjectReference Include="..\Dosi.Tracker.Application.Tests\Dosi.Tracker.Application.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.Sqlite" Version="10.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.8" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="10.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- The host's OpenIddict server and ABP's token endpoint, for the device-bound sign-in tests (Devices/). -->
    <PackageReference Include="Volo.Abp.OpenIddict.AspNetCore" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.Identity.AspNetCore" Version="10.5.0" />
  </ItemGroup>

</Project>
