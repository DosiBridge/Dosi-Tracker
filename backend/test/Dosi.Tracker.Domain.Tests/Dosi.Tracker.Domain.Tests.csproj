<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dosi.Tracker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dosi.Tracker.Domain\Dosi.Tracker.Domain.csproj" />
    <ProjectReference Include="..\Dosi.Tracker.TestBase\Dosi.Tracker.TestBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The production-secrets guard is pure logic that lives in HttpApi.Host. Test projects do not reference
         the host (it would drag the untested web-host wiring into the coverage gate), so its single source
         file is compiled into this test assembly instead. -->
    <Compile Include="..\..\src\Dosi.Tracker.HttpApi.Host\Security\ProductionSecretsGuard.cs" Link="Security\ProductionSecretsGuard.cs" />
  </ItemGroup>

</Project>
